<?xml version="1.0"?>
<package format="3">
  <name>robot_perception_interfaces</name>
  <version>0.6.0</version>
  <description>
    Perception 域提供的跨域公共接口：任务计划、精定位与障碍点云。
    对应 P-01～P-03；P-04 使用共享的 DomainReadiness。
  </description>
  <maintainer email="kkozia188@gmail.com">kkozia</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>unique_identifier_msgs</depend>
  <depend>robot_system_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
