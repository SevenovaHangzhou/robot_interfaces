# P-02 /perception/refine_sequence_poses。Autonomy ⇄ Perception。
#
# 结果必须是当时、当地、当前箱的精位姿。
# BoxPose.pose 表达吸取表面接触位姿，不是箱体几何中心。
# 前置条件：底盘静止、TF 与标定不变。
# 当前序列最多三次总尝试（含第一次）。

# 必须等于当前 producer instance 最近一次成功 P-01 返回的 WallTaskPlan.scene_id。
# 全零、过期、进程重启前或与当前计划不符的 scene_id 必须拒绝。
unique_identifier_msgs/UUID expected_scene_id

uint16 sequence_index

# 待精定位的箱，顺序即 Result 中的顺序。
string[] box_ids

# 与 box_ids 同长度、同序；取值使用 BoxPose.ARM_LEFT/ARM_RIGHT。
uint8[] arms

# 与 box_ids 同长度、同序；取值使用 BoxPose.SUCTION_TOP/SUCTION_SIDE。
# 必须与 P-01 冻结的吸取方式一致，P-02 不得根据新画面重新选择。
uint8[] suction_modes
---
bool ok

# 与 Goal box_ids 同数量、同集、同序。
# frame 为 base_link；stamp 为真实曝光时刻，不得填写处理完成时刻。
BoxPose[] boxes

robot_system_interfaces/ErrorInfo error
---
# feedback 静默超过 1 s 只告警。
string stage
