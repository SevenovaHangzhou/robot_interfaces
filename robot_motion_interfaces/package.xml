<?xml version="1.0"?>
<package format="3">
  <name>robot_motion_interfaces</name>
  <version>0.6.0</version>
  <description>
    Motion 域提供的跨域公共接口：导航执行、观测位执行、抓取与放置。
    对应 N-01 与 M-01～M-03。
  </description>
  <maintainer email="kkozia188@gmail.com">kkozia</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>robot_system_interfaces</depend>
  <depend>robot_perception_interfaces</depend>
  <depend>robot_rt_control_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
