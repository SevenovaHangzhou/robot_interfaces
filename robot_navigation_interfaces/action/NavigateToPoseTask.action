# N-01 succeeds when its internal Nav2 action returns SUCCEEDED.
# Result pose/errors are observations, not an independent physical-stop guarantee.
# Cancellation still requires confirmed standstill; otherwise abort.
string target_name
string map_version
---
string reached_target_name
geometry_msgs/PoseStamped final_base_pose
float32 arrival_error_m
float32 yaw_error_rad
string used_map_version
robot_system_interfaces/ErrorInfo error
---
string stage
float32 remaining_distance_m
float32 remaining_yaw_error_rad
