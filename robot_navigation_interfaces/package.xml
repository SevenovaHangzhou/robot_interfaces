<?xml version="1.0"?>
<package format="3">
  <name>robot_navigation_interfaces</name>
  <version>0.2.0</version>
  <description>
    导航能力域间接口：导航任务、定位状态。对应 N-01、N-05。
    /navigation/* 是能力命名空间，不表示存在 Navigation 域。
    底盘与手臂互斥是 Motion 域内不变量，无对应接口。
  </description>
  <maintainer email="kkozia188@gmail.com">kkozia</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>robot_system_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
